{
  "name": "reflect-site-backend",
  "version": "1.0.0",
  "description": "Backend for Re:flect brand identity and order management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit --coverage",
    "test:security": "eslint routes/ app.js db.js migrate.js",
    "test:load": "artillery run tests/load/scenario.yml",
    "test:a11y": "axe http://localhost:5173 --exit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "clearMocks": true,
    "collectCoverageFrom": ["routes/**/*.js", "app.js"],
    "coverageReporters": ["text", "lcov", "text-summary"]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^2.0.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.0",
    "artillery": "^2.0.21",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^3.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
